{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs-agent-readiness.local/schemas/v1/afdocs-0.18.7.schema.json",
  "type": "object",
  "required": [
    "type",
    "overallScore",
    "grade",
    "checksTotal",
    "checksPassed",
    "checksWarned",
    "checksFailed",
    "checksSkipped",
    "checks",
    "source",
    "sourceVersion",
    "sourceUrl",
    "measuredAt"
  ],
  "properties": {
    "type": { "const": "agent-score" },
    "overallScore": { "type": "number" },
    "grade": { "type": "string" },
    "checksTotal": { "type": "integer", "minimum": 0 },
    "checksPassed": { "type": "integer", "minimum": 0 },
    "checksWarned": { "type": "integer", "minimum": 0 },
    "checksFailed": { "type": "integer", "minimum": 0 },
    "checksSkipped": { "type": "integer", "minimum": 0 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "status", "message"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail", "skip"] },
          "message": { "type": "string" }
        }
      }
    },
    "source": { "const": "afdocs" },
    "sourceVersion": { "const": "0.18.7" },
    "sourceUrl": { "type": "string" },
    "measuredAt": { "type": "string" }
  }
}
