{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs-agent-readiness.local/schemas/v1/policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incompatible_baseline", "external_afdocs_required", "rules"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "incompatible_baseline": { "enum": ["ERROR", "ADVISORY"] },
    "baseline_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "external_afdocs_required": { "type": "boolean" },
    "external_afdocs_authenticity": { "enum": ["ANY", "ATTESTED"] },
    "required_completeness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SOURCE": { "$ref": "#/definitions/completeness" },
        "BUILD": { "$ref": "#/definitions/completeness" },
        "LIVE": { "$ref": "#/definitions/completeness" },
        "RUNTIME_OBSERVATION": { "$ref": "#/definitions/completeness" },
        "TASK_EVALUATION": { "$ref": "#/definitions/completeness" },
        "EXTERNAL": { "$ref": "#/definitions/completeness" }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect"],
        "properties": {
          "rule_id": { "type": "string", "maxLength": 200 },
          "finding_status": {
            "enum": ["PASS", "WARN", "FAIL", "SKIP", "NOT_APPLICABLE", "UNAVAILABLE"]
          },
          "regression_state": {
            "enum": ["NEW", "RESOLVED", "CHANGED", "UNCHANGED", "INCOMPATIBLE"]
          },
          "effect": { "enum": ["BLOCKING", "ADVISORY", "INFORMATIONAL"] }
        }
      }
    }
  },
  "definitions": {
    "completeness": {
      "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "NOT_REQUESTED"]
    }
  }
}
