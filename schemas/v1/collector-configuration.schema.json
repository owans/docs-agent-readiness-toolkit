{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs-agent-readiness.local/schemas/v1/collector-configuration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roots", "requested_modes", "inputs", "mappings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SOURCE": { "type": "string", "minLength": 1 },
        "BUILD": { "type": "string", "minLength": 1 },
        "IMPORT": { "type": "string", "minLength": 1 }
      }
    },
    "requested_modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["SOURCE", "BUILD", "LIVE", "RUNTIME_OBSERVATION", "TASK_EVALUATION"]
      }
    },
    "requested_external": { "type": "boolean" },
    "inputs": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/input" }
    },
    "mappings": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/mapping" }
    }
  },
  "definitions": {
    "trustedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "trust"],
      "properties": {
        "value": { "type": "string", "maxLength": 4096 },
        "trust": {
          "enum": [
            "OBSERVED_BY_COLLECTOR",
            "DETERMINISTICALLY_DERIVED",
            "USER_ASSERTED",
            "EXTERNALLY_ATTESTED"
          ]
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["COLLECTED", "IMPORTED", "ASSERTED", "ATTESTED"] },
        "collector": { "type": "string", "maxLength": 200 },
        "producer": { "type": "string", "maxLength": 200 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["DOCUMENT", "ARTIFACT", "DEPLOYMENT", "EXTERNAL_EVALUATION"] },
        "identity": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "locale": { "type": "string", "maxLength": 100 },
        "version": { "type": "string", "maxLength": 100 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "root", "path", "media_type", "acquisition", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 200 },
        "mode": {
          "enum": ["SOURCE", "BUILD", "LIVE", "RUNTIME_OBSERVATION", "TASK_EVALUATION"]
        },
        "root": { "enum": ["SOURCE", "BUILD", "IMPORT"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 200 },
        "acquisition": { "$ref": "#/definitions/acquisition" },
        "target": { "$ref": "#/definitions/target" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "$ref": "#/definitions/trustedValue" },
            "deployment_id": { "$ref": "#/definitions/trustedValue" },
            "observed_at": { "$ref": "#/definitions/trustedValue" },
            "generated_at": { "$ref": "#/definitions/trustedValue" },
            "authenticity": { "enum": ["UNVERIFIED", "ASSERTED", "ATTESTED"] }
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relation", "declared_trust"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 200 },
        "from": { "type": "string", "minLength": 1, "maxLength": 200 },
        "to": { "type": "string", "minLength": 1, "maxLength": 200 },
        "relation": { "enum": ["SOURCE_TO_BUILD", "BUILD_TO_EXPECTED_LIVE"] },
        "declared_trust": {
          "enum": [
            "OBSERVED_BY_COLLECTOR",
            "DETERMINISTICALLY_DERIVED",
            "USER_ASSERTED",
            "EXTERNALLY_ATTESTED"
          ]
        }
      }
    }
  }
}
