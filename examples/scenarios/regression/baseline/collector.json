{
  "schema_version": "1.0",
  "roots": {
    "SOURCE": "./source",
    "BUILD": "./build"
  },
  "requested_modes": ["SOURCE", "BUILD"],
  "inputs": [
    {
      "id": "source:page",
      "mode": "SOURCE",
      "root": "SOURCE",
      "path": "docs/page.md",
      "media_type": "text/markdown",
      "acquisition": {
        "kind": "COLLECTED",
        "collector": "local-source-v1"
      },
      "target": {
        "kind": "DOCUMENT",
        "identity": "page"
      }
    },
    {
      "id": "build:page",
      "mode": "BUILD",
      "root": "BUILD",
      "path": "page/index.html",
      "media_type": "text/html",
      "acquisition": {
        "kind": "COLLECTED",
        "collector": "local-build-v1"
      },
      "target": {
        "kind": "ARTIFACT",
        "identity": "build:page"
      }
    }
  ],
  "mappings": [
    {
      "id": "mapping:page",
      "from": "source:page",
      "to": "build:page",
      "relation": "SOURCE_TO_BUILD",
      "declared_trust": "USER_ASSERTED"
    }
  ]
}
